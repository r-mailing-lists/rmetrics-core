g1 <- addEdge("fEcofin", "fUtilities", g1)
g1 <- addEdge("fExoticOptions", "fOptions", g1)
g1 <- addEdge("fExtremes", "fBasics", g1)
g1 <- addEdge("fGarch", "fBasics", g1)
g1 <- addEdge("fGarch", "fArma", g1)
